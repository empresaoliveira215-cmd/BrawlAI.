                  switchBtn = btn("", violet) { toggleSwitch() }
                  l.addView(switchBtn)
                  l.addView(btn("Zerar aprendizado deste perfil", gray) { resetProfile() })

                  // ---- coleta para treinar a visao
                  l.addView(section("COLETA PARA TREINO (VISÃO COM IA)"))
                  collectBtn = btn("", Color.rgb(13, 148, 136)) { toggleCollect() }
                  l.addView(collectBtn)
                  l.addView(btn("Zerar contador da coleta", gray) {
                      ui().edit().putInt("collect_count", 0).apply()
                      refreshButtons()
                  })
                  refreshButtons()

                  // ---- cerebro
                  l.addView(section("CÉREBRO (MEMÓRIA)"))
                  l.addView(btn("Salvar backup do cérebro", green) {
                      Toast.makeText(this, Backup.exportToDownloads(this), Toast.LENGTH_LONG).show()
                  })
                  l.addView(btn("Restaurar backup do cérebro", gray) {
                      val i = Intent(Intent.ACTION_OPEN_DOCUMENT)
                      i.addCategory(Intent.CATEGORY_OPENABLE)
                      i.type = "*/*"
                      startActivityForResult(i, 91)
                  })

                  // ---- jogo
                  l.addView(section("JOGO"))
                  l.addView(btn("Abrir Brawl Stars", Color.rgb(234, 88, 12)) {
                      val i = packageManager.getLaunchIntentForPackage(BotService.GAME)
                      if (i != null) startActivity(i) else Toast.makeText(this, "Brawl Stars não encontrado", Toast.LENGTH_SHORT).show()
                  })

                  val help = TextView(this)
                  help.text = "Escolha o perfil da classe do brawler (ou deixe no automático) e abra o Brawl Stars: a IA começa sozinha. STOP vermelho (canto superior esquerdo) pausa e a IA passa a OBSERVAR você jogando; INICIAR devolve o controle. CAL = calibrar botões (5 toques: joystick, ataque, super, gadget, hipercarga). Segure o texto pequeno para salvar um print em Pictures/BrawlAI. A memória é salva ao sair do jogo e sobrevive às atualizações do app."
                  help.textSize = 12f
                  help.setTextColor(Color.rgb(148, 163, 184))
                  help.layoutParams = lp(22)
                  l.addView(help)

                  scroll.addView(l)
                  setContentView(scroll)
              }

              private fun ui() = getSharedPreferences("ui2", MODE_PRIVATE)
              private fun curProfile(): Int = getSharedPreferences("brain3", MODE_PRIVATE).getInt("profile", 0)

              private fun refreshButtons() {
                  profileBtn.text = "Perfil: " + Profiles.NAMES[curProfile()] + "  (toque para trocar)"
                  autoBtn.text = "Perfil automático (lê o brawler): " + (if (ui().getBoolean("auto_profile", true)) "LIGADO" else "DESLIGADO")
                  switchBtn.text = "Troca automática de brawler (1000 troféus): " + (if (ui().getBoolean("switch_on", true)) "LIGADA" else "DESLIGADA")
                  collectBtn.text = "Coleta de prints para treino: " + (if (ui().getBoolean("collect_on", false)) "LIGADA" else "DESLIGADA") + "  (" + ui().getInt("collect_count", 0) + " / 5000)"
              }

              private fun cycleProfile() {
                  val next = (curProfile() + 1) % Profiles.NAMES.size
                  getSharedPreferences("brain3", MODE_PRIVATE).edit().putInt("profile", next).commit()
                  ui().edit().putBoolean("auto_profile", false).apply()
                  refreshButtons()
                  BotService.instance?.reloadBrain()
                  Toast.makeText(this, "Perfil: " + Profiles.NAMES[next] + " (automático desligado)", Toast.LENGTH_SHORT).show()
              }

              private fun toggleAuto() {
                  ui().edit().putBoolean("auto_profile", !ui().getBoolean("auto_profile", true)).apply()
                  refreshButtons()
              }

              private fun toggleCollect() {
                  ui().edit().putBoolean("collect_on", !ui().getBoolean("collect_on", false)).apply()
                  refreshButtons()
                  if (ui().getBoolean("collect_on", false)) Toast.makeText(this, "Salvando em Downloads/BrawlAI/coleta enquanto o jogo estiver aberto", Toast.LENGTH_LONG).show()
              }

              private fun toggleSwitch() {
                  ui().edit().putBoolean("switch_on", !ui().getBoolean("switch_on", true)).apply()
                  refreshButtons()
              }

              private fun resetProfile() {
                  val p = curProfile()
                  getSharedPreferences("brain3", MODE_PRIVATE).edit()
                      .remove("params_" + p).remove("matches_" + p).remove("best_" + p).remove("q_" + p).commit()
                  BotService.instance?.reloadBrain()
                  Toast.makeText(this, "Aprendizado do perfil zerado", Toast.LENGTH_SHORT).show()
                  onResume()
              }

              private fun askCapture(force: Boolean) {
                  if (CaptureService.running) { Toast.makeText(this, "Visão em tempo real já está ativa", Toast.LENGTH_SHORT).show(); return }
                  val now = SystemClock.elapsedRealtime()
                  if (!force && now - lastAsk < 60000L) return
                  lastAsk = now
                  BotService.instance?.autoClick(40)
                  startActivity(Intent(this, ProjectionActivity::class.java))
              }

              override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
                  super.onActivityResult(requestCode, resultCode, data)
                  if (requestCode == 91 && resultCode == RESULT_OK) {
                      val uri = data?.data
                      if (uri != null) {
                          val ok = Backup.importFrom(this, uri)
                          if (ok) BotService.instance?.reloadBrain()
                          Toast.makeText(this, if (ok) "Cérebro restaurado!" else "Arquivo inválido", Toast.LENGTH_LONG).show()
                          refreshButtons()
                          onResume()
                      }
                  }
              }

              override fun onResume() {
                  super.onResume()
                  val prefs = getSharedPreferences("ui", MODE_PRIVATE)
                  val en = Settings.Secure.getString(contentResolver, Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES) ?: ""
                  val on = en.contains("$packageName/")
                  if (Build.VERSION.SDK_INT >= 33 && !prefs.getBoolean("notif", false)) {
                      prefs.edit().putBoolean("notif", true).apply()
                      requestPermissions(arrayOf(Manifest.permission.POST_NOTIFICATIONS), 5)
                  } else if (!on && !prefs.getBoolean("asked", false)) {
                      prefs.edit().putBoolean("asked", true).apply()
                      Toast.makeText(this, "Ative o Brawl AI na lista (Apps baixados)", Toast.LENGTH_LONG).show()
                      startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
                  } else if (on && !CaptureService.running && BotService.denyCount < 2) {
                      askCapture(false)
                  }
                  val br = getSharedPreferences("brain3", MODE_PRIVATE)
                  val pf = br.getInt("profile", 0)
                  val cap = if (CaptureService.running) "✅ Visão em TEMPO REAL ativa (" + BotService.fps + " fps)" else "⚠️ Visão lenta (3 fps). Toque no botão 5"
                  status.text = (if (on) "✅ Serviço ATIVO - é só abrir o Brawl Stars" else "❌ Serviço desativado. Passo 1; se o botão estiver cinza, faça o passo 2 e repita o 1") +
                      "\n" + cap +
                      "\nEstado: " + BotService.lastStatus +
                      "\nÚltima troca de brawler: " + ui().getString("switch_last", "ainda não tentou") +
                      "\nPerfil: " + Profiles.NAMES[pf] +
                      "\nPartidas aprendidas: " + br.getInt("matches_" + pf, 0) + "  |  melhor pontuação: " + br.getFloat("best_" + pf, 0f).toInt()
                  refreshButtons()
              }
          }
