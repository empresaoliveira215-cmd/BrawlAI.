          cat > app/src/main/java/com/brawlai/app/Brain.kt <<'BRAWLAI_EOF_7731'
          package com.brawlai.app

          import android.content.Context
          import android.content.SharedPreferences
          import kotlin.math.PI
          import kotlin.math.cos
          import kotlin.math.hypot
          import kotlin.math.sin
          import kotlin.random.Random

          /** Parametros de comportamento que a IA evolui. Distancias sao fracao da altura da tela. */
          class Params(
              var prefDist: Float = 0.30f,    // distancia preferida do inimigo
              var band: Float = 0.07f,
              var strafe: Float = 0.70f,      // segundos entre trocas de lado (zigue-zague)
              var fireRange: Float = 0.60f,
              var superRange: Float = 0.45f,
              var retreatHp: Float = 0.30f,
              var dodge: Float = 0.50f,
              var aimRange: Float = 0.30f,    // perto: toque (auto-mira). longe: mira manual
              var lead: Float = 0.15f,        // antecipacao da mira (segundos por "meia tela" de distancia)
              var gasAvoid: Float = 1.0f,     // forca de fuga do gas
              var selfSpeed: Float = 0.22f    // velocidade propria (alturas de tela por segundo), usada na mira
          ) {
              fun toArray() = floatArrayOf(prefDist, band, strafe, fireRange, superRange, retreatHp, dodge, aimRange, lead, gasAvoid, selfSpeed)

              companion object {
                  const val N = 11
                  val LO = floatArrayOf(0.15f, 0.03f, 0.30f, 0.35f, 0.25f, 0.10f, 0.20f, 0.12f, 0.00f, 0.30f, 0.05f)
                  val HI = floatArrayOf(0.50f, 0.15f, 1.60f, 0.85f, 0.70f, 0.60f, 1.00f, 0.55f, 0.60f, 2.50f, 0.45f)
                  fun from(a: FloatArray) = Params(a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10])
              }
          }

          /**
           * Conhecimento embutido: um perfil por CLASSE de brawler (as 7 classes do jogo + equilibrado).
           * Ordem: prefDist, band, strafe, fireRange, superRange, retreatHp, dodge, aimRange, lead, gasAvoid, selfSpeed.
           */
          object Profiles {
              val NAMES = arrayOf(
                  "Equilibrado", "Dano (Damage Dealer)", "Tanque", "Atirador (Marksman)",
                  "Artilharia", "Assassino", "Suporte", "Controlador"
              )
              val PRESETS = arrayOf(
                  floatArrayOf(0.30f, 0.07f, 0.70f, 0.60f, 0.45f, 0.30f, 0.50f, 0.30f, 0.15f, 1.0f, 0.22f),
                  floatArrayOf(0.28f, 0.07f, 0.65f, 0.58f, 0.42f, 0.28f, 0.50f, 0.30f, 0.12f, 1.0f, 0.22f),
                  floatArrayOf(0.17f, 0.05f, 0.50f, 0.38f, 0.30f, 0.14f, 0.30f, 0.35f, 0.05f, 1.0f, 0.20f),
                  floatArrayOf(0.45f, 0.06f, 0.90f, 0.82f, 0.65f, 0.40f, 0.60f, 0.28f, 0.30f, 1.2f, 0.22f),
                  floatArrayOf(0.40f, 0.07f, 1.00f, 0.66f, 0.55f, 0.35f, 0.50f, 0.15f, 0.35f, 1.1f, 0.20f),
                  floatArrayOf(0.16f, 0.05f, 0.40f, 0.36f, 0.26f, 0.25f, 0.50f, 0.32f, 0.05f, 1.0f, 0.28f),
                  floatArrayOf(0.35f, 0.07f, 0.90f, 0.56f, 0.45f, 0.40f, 0.60f, 0.30f, 0.15f, 1.2f, 0.22f),
                  floatArrayOf(0.32f, 0.07f, 0.80f, 0.62f, 0.50f, 0.35f, 0.50f, 0.22f, 0.25f, 1.1f, 0.22f)
