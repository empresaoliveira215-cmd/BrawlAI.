              // ---------------------------------------------------------------- ciclo de vida
              override fun onServiceConnected() {
                  instance = this
                  wm = getSystemService(Context.WINDOW_SERVICE) as WindowManager
                  brain = Brain(this)
                  vision.gasSig = brain.signature()
                  loadCal()
                  refreshScreen()
                  buildOverlay()
                  lastStatus = "pronto - aguardando Brawl Stars"
                  main.post(watchdog)
              }

              override fun onInterrupt() {}

              override fun onDestroy() {
                  instance = null
                  try { synchronized(procLock) { if (::brain.isInitialized) brain.flush() } } catch (e: Throwable) { }
                  setGame(false)
                  try { overlay?.let { wm.removeView(it) } } catch (e: Exception) { }
                  super.onDestroy()
              }

              private fun isNoise(pkg: String) =
                  pkg == packageName || pkg == "android" || pkg.startsWith("com.android.systemui") || pkg.contains("inputmethod")

              override fun onAccessibilityEvent(e: AccessibilityEvent) {
                  if (e.eventType != AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED) return
                  val pkg = e.packageName?.toString() ?: return
                  if (isNoise(pkg)) return
                  setGame(pkg == GAME)
              }

              // confere de tempos em tempos (caso o jogo ja estivesse aberto quando o servico ligou)
              private val watchdog = object : Runnable {
                  override fun run() {
                      try {
                          refreshScreen()
                          val p = rootInActiveWindow?.packageName?.toString()
                          if (p != null && !isNoise(p)) setGame(p == GAME)
                      } catch (e: Exception) { }
                      main.postDelayed(this, 2000)
                  }
              }

              private fun refreshScreen() {
                  try {
                      val b = wm.maximumWindowMetrics.bounds
                      sw = b.width()
                      sh = b.height()
                  } catch (e: Exception) { }
              }

              private fun setGame(front: Boolean) {
                  if (front == gameFront) return
                  gameFront = front
                  val now = SystemClock.elapsedRealtime()
                  if (front) {
                      if (leftAt == 0L || now - leftAt > 5000) userStopped = false   // entrou no Brawl Stars -> a IA liga sozinha
                      exec.execute { try { synchronized(procLock) { resetMatch() } } catch (e: Throwable) { } }
                      overlay?.visibility = View.VISIBLE
                      refreshButtons()
                      refreshScreen()
                      startLoops()
                      maybeRequestCapture()
                  } else {
                      leftAt = now
                      overlay?.visibility = View.GONE
                      exec.execute { try { synchronized(procLock) { if (::brain.isInitialized) brain.flush() } } catch (e: Throwable) { } }
                      moving = false; wantFire = false; wantAim = false; menuTap = null
                      lastStatus = "parado (fora do Brawl Stars)"
                  }
              }

              // ---------------------------------------------------------------- captura em tempo real (pede permissao 1x e confirma o dialogo sozinho)
              private fun maybeRequestCapture() {
                  if (CaptureService.running || denyCount >= 2 || inMatch) return
                  val now = SystemClock.elapsedRealtime()
                  if (now - lastCaptureAsk < 60000L) return
                  lastCaptureAsk = now
                  requestCapture()
              }

              fun requestCapture() {
                  if (CaptureService.running) return
                  try {
                      val i = Intent(this, ProjectionActivity::class.java)
                      i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                      startActivity(i)
                      autoClick(40)
                  } catch (e: Exception) {
                      status("nao abriu o pedido de captura")
                  }
              }

              private val clickLabels = arrayOf("começar agora", "iniciar agora", "start now", "permitir", "allow", "começar", "iniciar", "start")

              fun autoClick(tries: Int) {
                  if (tries <= 0 || CaptureService.running) return
                  var done = false
                  try {
                      val root = rootInActiveWindow
                      val pkg = root?.packageName?.toString() ?: ""
                      if (root != null && (pkg.contains("systemui") || pkg.contains("securitycenter") || pkg.contains("permission") || pkg == "android")) {
                          done = clickByLabel(root)
                      }
                  } catch (e: Exception) { }
                  if (!done) main.postDelayed({ autoClick(tries - 1) }, 300)
              }

              private fun clickByLabel(root: AccessibilityNodeInfo): Boolean {
                  for (label in clickLabels) {
                      val list = root.findAccessibilityNodeInfosByText(label) ?: continue
                      for (node in list) {
                          val t = node.text?.toString()?.lowercase() ?: ""
                          if (t.contains("cancel") || t.contains("não") || t.contains("nao")) continue
                          var n: AccessibilityNodeInfo? = node
                          var depth = 0
                          while (n != null && depth < 3) {
                              if (n.isClickable) return n.performAction(AccessibilityNodeInfo.ACTION_CLICK)
                              n = n.parent
                              depth++
                          }
                      }
                  }
                  return false
              }

              // ---------------------------------------------------------------- overlay (STOP / CAL)
              private fun dp(v: Int) = (v * resources.displayMetrics.density).toInt()

              private fun buildOverlay() {
                  val root = LinearLayout(this)
                  root.orientation = LinearLayout.VERTICAL
                  val row = LinearLayout(this)
                  row.orientation = LinearLayout.HORIZONTAL

                  stopBtn = TextView(this)
                  stopBtn.text = "STOP"
                  stopBtn.setTextColor(Color.WHITE)
                  stopBtn.textSize = 15f
                  stopBtn.setTypeface(null, Typeface.BOLD)
                  stopBtn.setPadding(dp(14), dp(8), dp(14), dp(8))
                  stopBtn.setBackgroundColor(Color.rgb(210, 30, 30))
                  stopBtn.setOnClickListener {
                      val nowStopped = !userStopped
                      userStopped = nowStopped
                      if (nowStopped) {
                          moving = false; wantFire = false; wantAim = false; menuTap = null
                      } else {
                          exec.execute { try { synchronized(procLock) { applyObservation() } } catch (e: Throwable) { } }
                      }
                      refreshButtons()
                      startLoops()
                  }

                  val cal = TextView(this)
                  cal.text = "CAL"
                  cal.setTextColor(Color.WHITE)
                  cal.textSize = 13f
                  cal.setPadding(dp(10), dp(8), dp(10), dp(8))
                  cal.setBackgroundColor(Color.argb(200, 40, 70, 140))
                  cal.setOnClickListener { startCalibration() }

                  row.addView(stopBtn)
                  row.addView(cal)

                  info = TextView(this)
                  info.text = "..."
                  info.setTextColor(Color.WHITE)
                  info.textSize = 10f
                  info.setBackgroundColor(Color.argb(150, 0, 0, 0))
                  info.setPadding(dp(4), dp(2), dp(4), dp(2))
                  info.setOnLongClickListener { saveDebug(); true }

                  root.addView(row)
                  root.addView(info)
                  val lp = WindowManager.LayoutParams(
                      WindowManager.LayoutParams.WRAP_CONTENT, WindowManager.LayoutParams.WRAP_CONTENT,
                      WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
                      WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL,
                      PixelFormat.TRANSLUCENT
                  )
                  lp.gravity = Gravity.TOP or Gravity.START
                  lp.x = dp(6)
                  lp.y = dp(4)
                  root.visibility = View.GONE
                  wm.addView(root, lp)
                  overlay = root
              }

              private fun refreshButtons() {
                  main.post {
                      if (userStopped) { stopBtn.text = "INICIAR"; stopBtn.setBackgroundColor(Color.rgb(30, 150, 60)) }
                      else { stopBtn.text = "STOP"; stopBtn.setBackgroundColor(Color.rgb(210, 30, 30)) }
                  }
              }

              /** Chamado pelo app quando o perfil muda ou o aprendizado e zerado. */
              fun reloadBrain() {
                  exec.execute {
                      try {
                          synchronized(procLock) {
                              brain = Brain(this)
                              vision.gasSig = brain.signature()
                              policy = null; params = null
                          }
                      } catch (e: Throwable) { }
                  }
              }

              private fun status(s: String) {
                  lastStatus = s
                  val now = SystemClock.elapsedRealtime()
                  if (now - lastStatusAt < 200L) return
                  lastStatusAt = now
                  val src = if (CaptureService.running) "TEMPO REAL " + fps + "fps" else "modo lento 3fps"
                  main.post { if (::info.isInitialized) info.text = s + "\n" + src }
              }

              // ---------------------------------------------------------------- calibracao: toque nos botoes reais
              private fun loadCal() {
                  val sp = getSharedPreferences("cal", Context.MODE_PRIVATE)
                  jx = sp.getFloat("jx", jx); jy = sp.getFloat("jy", jy)
                  ax = sp.getFloat("ax", ax); ay = sp.getFloat("ay", ay)
                  ux = sp.getFloat("ux", ux); uy = sp.getFloat("uy", uy)
                  gx = sp.getFloat("gx", gx); gy = sp.getFloat("gy", gy)
                  hx = sp.getFloat("hx", hx); hy = sp.getFloat("hy", hy)
              }

              private fun startCalibration() {
                  if (calView != null) return
                  val names = arrayOf("JOYSTICK (onde seu dedo anda)", "botao de ATAQUE", "botao de SUPER", "botao de GADGET", "botao de HIPERCARGA")
                  var step = 0
                  val vals = FloatArray(10)
                  val tv = TextView(this)
                  tv.setBackgroundColor(Color.argb(140, 0, 0, 0))
                  tv.setTextColor(Color.WHITE)
                  tv.textSize = 20f
                  tv.gravity = Gravity.CENTER
                  tv.text = "CALIBRAR 1/5\nToque no centro do " + names[0]
                  tv.setOnTouchListener { _, ev ->
                      if (ev.action == MotionEvent.ACTION_DOWN) {
                          val bounds = wm.maximumWindowMetrics.bounds
                          vals[step * 2] = (ev.rawX / maxOf(bounds.width(), 1)).coerceIn(0f, 1f)
                          vals[step * 2 + 1] = (ev.rawY / maxOf(bounds.height(), 1)).coerceIn(0f, 1f)
                          step++
                          if (step >= 5) {
                              getSharedPreferences("cal", Context.MODE_PRIVATE).edit()
                                  .putFloat("jx", vals[0]).putFloat("jy", vals[1]).putFloat("ax", vals[2]).putFloat("ay", vals[3])
                                  .putFloat("ux", vals[4]).putFloat("uy", vals[5]).putFloat("gx", vals[6]).putFloat("gy", vals[7]).putFloat("hx", vals[8]).putFloat("hy", vals[9]).apply()
                              loadCal()
                              wm.removeView(tv)
                              calView = null
                              status("calibrado!")
                          } else {
                              tv.text = "CALIBRAR " + (step + 1) + "/5\nToque no centro do " + names[step]
                          }
                      }
                      true
                  }
                  val lp = WindowManager.LayoutParams(
                      WindowManager.LayoutParams.MATCH_PARENT, WindowManager.LayoutParams.MATCH_PARENT,
                      WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
                      WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
                      PixelFormat.TRANSLUCENT
                  )
                  calView = tv
                  wm.addView(tv, lp)
              }

              private fun saveDebug() {
                  val b = lastBmp ?: return
                  exec.execute {
                      try {
                          val v = ContentValues()
                          v.put(MediaStore.Images.Media.DISPLAY_NAME, "brawlai_" + System.currentTimeMillis() + ".png")
                          v.put(MediaStore.Images.Media.MIME_TYPE, "image/png")
                          v.put(MediaStore.Images.Media.RELATIVE_PATH, "Pictures/BrawlAI")
                          val uri = contentResolver.insert(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, v)
                          if (uri != null) {
                              contentResolver.openOutputStream(uri)?.use { b.compress(Bitmap.CompressFormat.PNG, 100, it) }
                              status("print salvo em Pictures/BrawlAI")
                          }
                      } catch (e: Throwable) { }
                  }
              }

              // ---------------------------------------------------------------- fonte de imagem
              private fun startLoops() {
                  if (!loopOn) { loopOn = true; main.post { visionTick() } }
                  if (!ctrlOn) { ctrlOn = true; main.post { controlTick() } }
              }

              /** Quadro vindo da captura em tempo real (thread da captura). */
              fun onFrame(bmp: Bitmap, w: Int, h: Int) {
                  val now = SystemClock.elapsedRealtime()
                  lastCapAt = now
                  if (!gameFront) return
                  if (!inMatch && now - lastProcAt < 140L) return      // menus: sem pressa
                  lastBmp = bmp
                  try {
                      synchronized(procLock) { process(bmp, w, h, now) }
                  } catch (t: Throwable) {
                      status("erro IA: " + t.javaClass.simpleName)
                  }
                  lastProcAt = now
                  fpsCount++
                  if (now - fpsT0 >= 1000L) { fps = fpsCount; fpsCount = 0; fpsT0 = now }
              }

              private fun next(started: Long) {
                  val wait = maxOf(30L, 350L - (SystemClock.elapsedRealtime() - started))   // a API de print limita ~3/s
                  main.postDelayed({ visionTick() }, wait)
              }

              /** Plano B: prints pela Acessibilidade (~3/s) quando a captura em tempo real nao esta ativa. */
              private fun visionTick() {
                  if (!gameFront) { loopOn = false; return }
                  val started = SystemClock.elapsedRealtime()
                  if (started - lastCapAt < 700L) { main.postDelayed({ visionTick() }, 300); return }
                  try {
                      takeScreenshot(Display.DEFAULT_DISPLAY, exec, object : TakeScreenshotCallback {
                          override fun onSuccess(r: ScreenshotResult) {
                              try {
                                  val hw = Bitmap.wrapHardwareBuffer(r.hardwareBuffer, r.colorSpace)
                                  val soft = hw?.copy(Bitmap.Config.ARGB_8888, false)
                                  try { r.hardwareBuffer.close() } catch (e: Throwable) { }
                                  if (soft != null && soft.width > soft.height) {
                                      sw = soft.width
                                      sh = soft.height
                                      lastBmp = soft
                                      val small = Bitmap.createScaledBitmap(soft, 512, maxOf(1, 512 * soft.height / soft.width), true)
                                      synchronized(procLock) { process(small, small.width, small.height, SystemClock.elapsedRealtime()) }
                                  } else {
                                      status("tela fora de paisagem ou sem imagem")
                                  }
                              } catch (t: Throwable) {
                                  status("erro: " + t.javaClass.simpleName)
                              }
                              next(started)
                          }

                          override fun onFailure(errorCode: Int) {
                              status("screenshot falhou ($errorCode)")
                              next(started)
                          }
                      })
                  } catch (e: Exception) {
                      status("erro: " + e.message)
                      main.postDelayed({ visionTick() }, 800)
                  }
              }

              // ---------------------------------------------------------------- IA (sempre dentro de synchronized(procLock))
              private fun resetMatch() {
                  inMatch = false; matchSince = 0L; nonSince = 0L; policy = null; params = null
                  moving = false; wantFire = false; wantAim = false
              }

              private fun applyObservation() {
                  val r = obs.result()
                  if (r != null) {
                      brain.seedFromObservation(r[0], r[1], r[2])
                      status("aprendi com voce: distancia " + (r[0] * 100).toInt() + "%")
                      obs.clear()
                  }
              }

              private fun startMatch(now: Long) {
                  inMatch = true
                  stats = MatchStats()
                  observedThisMatch = false
                  policy = null; params = null
                  maxBar = 0f; smHp = -1f; refHp = -1f; curHp = -1f
                  lastTgt = null; tvx = 0f; tvy = 0f
                  prevVx = 0f; prevVy = 0f; speedEma = 0f; flipEma = 0f; dmgRecent = 0f; turbo = false
                  allyMax = 0; matchT0 = now; prevGas = null; gasClosing = false; blockedUntil = 0L; lastDealt = 0f
                  for (i in 0 until 9) gasRate[i] = 0f
                  lastPerceiveAt = 0L; lastDmgAt = 0L; lastBaseAt = 0L
                  prevSig = null; stillMs = 0L
              }

              private fun endMatch(now: Long) {
                  inMatch = false
                  if (!observedThisMatch) matchesSinceCheck++
                  val p = params
                  if (p != null && !observedThisMatch) {
                      stats.durSec = (now - polT0) / 1000f
                      if (stats.durSec > 15f) brain.report(p, stats)
                  }
                  brain.flush()
                  vision.gasSig = brain.signature()
                  policy = null; params = null
                  moving = false; wantFire = false; wantAim = false
                  noButtonSince = now; nextMenuTapAt = now + 2500
              }

              private fun process(bmp: Bitmap, w: Int, h: Int, now: Long) {
                  val a = vision.analyze(bmp, w, h)
                  maybeCollect(bmp, w, h, a, now)
                  if (a.inMatch) { nonSince = 0L; if (matchSince == 0L) matchSince = now }
                  else { matchSince = 0L; if (nonSince == 0L) nonSince = now }

                  if (!inMatch && matchSince != 0L && now - matchSince >= 500L) startMatch(now)
                  else if (inMatch && nonSince != 0L && now - nonSince >= 2000L) endMatch(now)

                  if (!inMatch) { menuStep(a, now); return }

                  if (userStopped) { observedThisMatch = true; observeStep(a, now); return }
                  if (policy == null) {
                      val p = brain.sample()
                      params = p
                      policy = Policy(p, h.toFloat(), brain.q, brain.epsilon())
                      polT0 = now
                  }
                  matchStep(a, now, policy!!)
              }

              /** Percepcao comum: vida, dano, alvo, velocidade do alvo, aprendizado do gas. */
              private fun perceive(a: Analysis, now: Long) {
                  dtMs = if (lastPerceiveAt == 0L) 0L else now - lastPerceiveAt
                  lastPerceiveAt = now
                  curHp = -1f
                  if (a.myBarW > 0f) {
                      if (maxBar <= 0f) maxBar = a.myBarW
                      else if (a.myBarW > maxBar) maxBar = minOf(a.myBarW, maxBar * 1.3f)
                      val raw = (a.myBarW / maxBar).coerceIn(0f, 1f)
                      smHp = if (smHp < 0f) raw else smHp + 0.35f * (raw - smHp)
                      curHp = smHp
                      if (refHp < 0f || smHp > refHp) refHp = smHp
                  }
                  dmgNow = 0f
                  if (curHp >= 0f && refHp - curHp >= 0.06f) { dmgNow = refHp - curHp; refHp = curHp }

                  var tgt: FloatArray? = null
                  var bd = Float.MAX_VALUE
                  for (e in a.enemies) {
                      val dx = e[0] - a.meX
                      val dy = e[1] - a.meY
                      val d2 = dx * dx + dy * dy
                      if (d2 < bd) { bd = d2; tgt = e }
                  }
                  tDist = if (tgt != null) Math.sqrt(bd.toDouble()).toFloat() / a.h else -1f
                  if (tgt != null) {
                      val lt = lastTgt
                      val dts = dtMs / 1000f
                      if (lt != null && dts > 0f && dts < 0.4f && hypot(tgt[0] - lt[0], tgt[1] - lt[1]) < 0.15f * a.h) {
                          val vx = (tgt[0] - lt[0]) / dts
                          val vy = (tgt[1] - lt[1]) / dts
                          tvx = (tvx * 0.7f + vx * 0.3f).coerceIn(-0.8f * a.h, 0.8f * a.h)
                          tvy = (tvy * 0.7f + vy * 0.3f).coerceIn(-0.8f * a.h, 0.8f * a.h)
                          val spd = hypot(tvx, tvy) / a.h
                          speedEma += 0.1f * (spd - speedEma)
                          if (prevVx * tvx + prevVy * tvy < 0f && hypot(prevVx, prevVy) > 0.05f * a.h && spd > 0.05f) flipEma += 1f
                          prevVx = tvx
                          prevVy = tvy
                          if (tMaxW <= 0f) tMaxW = tgt[2] else if (tgt[2] > tMaxW) tMaxW = minOf(tgt[2], tMaxW * 1.3f)
                          val frac = (tgt[2] / tMaxW).coerceIn(0f, 1f)
                          tSm += 0.35f * (frac - tSm)
                          if (tSm > tRef) tRef = tSm
                          if (tRef - tSm >= 0.08f) { stats.dmgDealt += tRef - tSm; tRef = tSm }
                      } else {
                          tvx = 0f; tvy = 0f; tMaxW = tgt[2]; tSm = 1f; tRef = 1f; prevVx = 0f; prevVy = 0f
                      }
                      lastTgt = floatArrayOf(tgt[0], tgt[1])
                  } else {
                      lastTgt = null; tvx = 0f; tvy = 0f
                  }

                  // modo turbo: inimigo rapido, que muda de direcao toda hora ou que esta nos machucando
                  flipEma *= 0.97f
                  speedEma *= 0.995f
                  dmgRecent = dmgRecent * 0.98f + (if (dmgNow > 0f && a.enemies.isNotEmpty()) dmgNow else 0f)
                  val threat = 0.5f * minOf(1f, speedEma / 0.35f) + 0.3f * minOf(1f, flipEma / 3f) + 0.2f * minOf(1f, dmgRecent / 0.3f)
                  if (!turbo && threat > 0.55f) turbo = true else if (turbo && threat < 0.35f) turbo = false

                  // aprendizado do gas: dano sem inimigo a vista = provavel gas -> guarda como ele "parece" em volta do jogador
                  if (dmgNow > 0f) {
                      lastDmgAt = now
                      if (a.enemies.isEmpty()) {
                          stats.gasLoss += dmgNow
                          val tmp = FloatArray(96)
                          vision.ringHist(a.meX, a.meY, tmp)
                          brain.addGas(tmp)
                          vision.gasSig = brain.signature()
                      } else {
                          stats.hits++
                      }
                  } else if (curHp >= 0f && now - lastDmgAt > 1500L && now - lastBaseAt > 700L) {
                      lastBaseAt = now
                      val tmp = FloatArray(96)
                      vision.ringHist(a.meX, a.meY, tmp)
                      brain.addBase(tmp)
                  }
              }

              // ---------------------------------------------------------------- coleta de dados (modo treino)
              private fun toJsonArr(l: List<FloatArray>): JSONArray {
                  val r = JSONArray()
                  for (e in l) {
                      val x = JSONArray()
                      for (v in e) x.put(v.toDouble())
                      r.put(x)
                  }
                  return r
              }

              /** Salva um print (+ o que a IA detectou nele) em Downloads/BrawlAI/coleta, para treinar um detector de verdade depois. */
              private fun maybeCollect(bmp: Bitmap, w: Int, h: Int, a: Analysis, now: Long) {
                  val ui = getSharedPreferences("ui2", Context.MODE_PRIVATE)
                  if (!ui.getBoolean("collect_on", false)) return
                  val gap = if (a.inMatch) 1500L else 4000L
                  if (now - lastCollectAt < gap || colBusy) return
                  val count = ui.getInt("collect_count", 0)
                  if (count >= 5000) return
                  lastCollectAt = now
                  colBusy = true
                  try {
                      val copy = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
                      Canvas(copy).drawBitmap(bmp, 0f, 0f, null)
                      val meta = JSONObject()
                      meta.put("w", w)
                      meta.put("h", h)
                      meta.put("inMatch", a.inMatch)
                      meta.put("me", JSONArray().put(a.meX.toDouble()).put(a.meY.toDouble()).put(a.myBarW.toDouble()))
                      meta.put("enemies", toJsonArr(a.enemies))
                      meta.put("allies", toJsonArr(a.allies))
                      meta.put("hp", curHp.toDouble())
                      val gs = a.gas
                      if (gs != null) {
                          val g = JSONArray()
                          for (v in gs) g.put(v.toDouble())
                          meta.put("gas", g)
                      }
                      meta.put("profile", Profiles.NAMES[brain.profile])
                      meta.put("turbo", turbo)
                      val json = meta.toString()
                      colExec.execute {
                          try {
                              saveSample(copy, json, count)
                          } catch (e: Throwable) {
                          } finally {
                              colBusy = false
                          }
                      }
                  } catch (e: Throwable) {
                      colBusy = false
                  }
              }

              private fun saveSample(bmp: Bitmap, json: String, count: Int) {
                  val base = "f_" + System.currentTimeMillis()
                  val res = contentResolver
                  val v1 = ContentValues()
                  v1.put(MediaStore.Downloads.DISPLAY_NAME, base + ".jpg")
                  v1.put(MediaStore.Downloads.MIME_TYPE, "image/jpeg")
                  v1.put(MediaStore.Downloads.RELATIVE_PATH, "Download/BrawlAI/coleta")
                  val u1 = res.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, v1) ?: return
                  res.openOutputStream(u1)?.use { bmp.compress(Bitmap.CompressFormat.JPEG, 88, it) }
                  val v2 = ContentValues()
                  v2.put(MediaStore.Downloads.DISPLAY_NAME, base + ".json")
                  v2.put(MediaStore.Downloads.MIME_TYPE, "application/json")
                  v2.put(MediaStore.Downloads.RELATIVE_PATH, "Download/BrawlAI/coleta")
                  val u2 = res.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, v2) ?: return
                  res.openOutputStream(u2)?.use { it.write(json.toByteArray(Charsets.UTF_8)) }
                  getSharedPreferences("ui2", Context.MODE_PRIVATE).edit().putInt("collect_count", count + 1).apply()
              }

              /** Preenche tudo que a politica precisa: aliados, modo de jogo, previsao do gas, paredes, velocidade para mirar. */
              private fun fillPercept(a: Analysis, now: Long, hp: Float?) {
                  pc.now = now / 1000.0
                  pc.meX = a.meX
                  pc.meY = a.meY
                  pc.enemies = a.enemies
                  pc.allies = a.allies
                  pc.hp = if (hp != null) hp else -1f
                  pc.dmg = dmgNow > 0f
                  pc.stuck = stillMs >= 700L
                  pc.gas = predictGas(a, now)
                  pc.tvx = tvx
                  pc.tvy = tvy
                  pc.turbo = turbo
                  pc.erratic = minOf(1f, flipEma / 3f)
                  val pr = params
                  val spd = (if (pr != null) pr.selfSpeed else 0.22f) * a.h
                  val free = moving && stillMs < 400L
                  pc.myVx = if (free) moveX * spd else 0f
                  pc.myVy = if (free) moveY * spd else 0f
                  // parede: lembra a direcao em que ficamos presos
                  if (stillMs >= 700L && moving) { blkX = moveX; blkY = moveY; blockedUntil = now + 2500L }
                  pc.blocked = now < blockedUntil
                  pc.blockedX = blkX
                  pc.blockedY = blkY
                  if (a.allies.size > allyMax) allyMax = a.allies.size
                  pc.mode = if (now - matchT0 < 3000L) 0 else if (allyMax >= 2) 2 else if (allyMax == 1) 1 else 0
              }

              /** Gas que se move e fecha o mapa: mede a velocidade com que ele cresce em cada setor e preve 1,5 s a frente. */
              private fun predictGas(a: Analysis, now: Long): FloatArray? {
                  val g = a.gas
                  if (g == null) { prevGas = null; return null }
                  val pg = prevGas
                  val dt = (now - prevGasAt) / 1000f
                  val out = FloatArray(9)
                  for (k in 0 until 9) {
                      if (pg != null && dt > 0f && dt < 0.5f) {
                          val rate = (g[k] - pg[k]) / dt
                          gasRate[k] = gasRate[k] * 0.9f + rate * 0.1f
                      }
                      out[k] = (g[k] + (if (k < 8) gasRate[k] * 1.5f else 0f)).coerceIn(0f, 1f)
                  }
                  prevGas = g
                  prevGasAt = now
                  var closing = false
                  for (k in 0 until 8) if (gasRate[k] > 0.05f) closing = true
                  gasClosing = closing
                  return out
              }

              private fun observeStep(a: Analysis, now: Long) {
                  moving = false; wantFire = false; wantAim = false
                  perceive(a, now)
                  if (tDist >= 0f && curHp >= 0f) obs.add(tDist, curHp)
                  status("OBSERVANDO voce jogar | quadros=" + obs.n + " | inim=" + a.enemies.size)
              }

              private fun matchStep(a: Analysis, now: Long, pol: Policy) {
                  perceive(a, now)
                  // preso? (tela parada enquanto andamos)
                  val ps = prevSig
                  if (ps == null) { prevSig = a.sig; prevSigAt = now }
                  else if (now - prevSigAt >= 250L) {
                      var diff = 0
                      for (i in a.sig.indices) diff += Math.abs(a.sig[i] - ps[i])
                      if (diff / a.sig.size < 2 && moving) stillMs += now - prevSigAt else stillMs = 0L
                      prevSig = a.sig
                      prevSigAt = now
                  }
                  val hp: Float? = if (curHp >= 0f) curHp else null
                  fillPercept(a, now, hp)
                  val enemyVisible = a.enemies.isNotEmpty()
                  val dealtNow = stats.dmgDealt - lastDealt
                  lastDealt = stats.dmgDealt
                  pol.reward(3f * dealtNow - 4f * (if (enemyVisible) dmgNow else 0f) - 5f * (if (!enemyVisible) dmgNow else 0f))
                  val m = pol.decide(pc)
                  if (m.engaged) stats.engagedSec += dtMs / 1000f
                  moveX = m.dx
                  moveY = m.dy
                  moving = true
                  if (m.fire == 1) {
                      wantFire = true
                  } else {
                      wantFire = false
                      if (m.fire == 2 && now - lastAimAt >= 280L) {
                          aimX = m.aimX; aimY = m.aimY
                          wantAim = true
                          lastAimAt = now
                      }
                  }
                  val superCd = if (turbo) 1200L else 2500L
                  if (m.sup && now - lastSuperAt > superCd) { wantSuper = true; lastSuperAt = now }
                  val gadgetCd = if (turbo || (hp != null && hp < 0.5f)) 3500L else 7000L
                  if (m.engaged && now - lastGadgetAt > gadgetCd) { wantGadget = true; lastGadgetAt = now }
                  val hyperCd = if (turbo) 4000L else 9000L
                  if (m.engaged && now - lastHyperAt > hyperCd) { wantHyper = true; lastHyperAt = now }
                  val hpTxt = if (hp != null) (hp * 100).toInt().toString() else "?"
                  val gasTxt = if (a.gas != null) " gas=" + (a.gas[8] * 100).toInt() + "%" else ""
                  status("PARTIDA " + actNames[m.act] + (if (turbo) " TURBO" else "") + (if (gasClosing) " GAS-FECHANDO" else "") + " [" + Profiles.NAMES[brain.profile].substringBefore(" ") + "/" + arrayOf("solo", "dupla", "equipe")[pc.mode] + "] aliados=" + a.allies.size + " | inim=" + a.enemies.size + " hp=" + hpTxt + "%" + gasTxt + " | partidas=" + brain.matches + " melhor=" + brain.bestScore.toInt())
              }

              private fun menuStep(a: Analysis, now: Long) {
                  moving = false; wantFire = false; wantAim = false
                  val extra = "r=" + (a.redRatio * 100).toInt() + "% y=" + (a.yellowRatio * 100).toInt() + "%"
                  if (userStopped) { status("PAUSADO (STOP) | $extra"); return }
                  val bt = a.button
                  val inLobbyArea = bt != null && bt[0] > 0.70f && bt[1] > 0.72f
                  if (inLobbyArea) lobbyAt = now
                  if (swActive) { status("TROCA DE BRAWLER: " + swMsg); return }
                  if (inLobbyArea && maybeStartSwitch(now)) return
                  if (now < nextMenuTapAt) { status("MENU | $extra"); return }
                  val b = a.button
                  if (b != null) {
                      menuTap = floatArrayOf(b[0], b[1]); nextMenuTapAt = now + 2000; noButtonSince = now
                      status("MENU: tocando botao amarelo | $extra")
                      return
                  }
                  if (now - noButtonSince > 9000) {   // nada conhecido na tela: tenta saidas (nunca toca no topo-esquerdo, onde fica o STOP)
                      val g = a.greenButton
                      val t: FloatArray = when (fallbackIdx % 3) {
                          0 -> g ?: floatArrayOf(0.5f, 0.92f)
                          1 -> floatArrayOf(0.5f, 0.92f)
                          else -> floatArrayOf(0.95f, 0.08f)
                      }
                      fallbackIdx++
                      menuTap = t; nextMenuTapAt = now + 3000
                      status("MENU: tentando continuar | $extra")
                  } else status("MENU: aguardando | $extra")
              }

              // ---------------------------------------------------------------- troca automatica de brawler (OCR)
              private val selectLabels = arrayOf("selecionar", "select", "seleccionar", "sélectionner", "auswählen", "selezionare")
              private val playLabels = arrayOf("jogar", "play", "jugar", "jouer", "spielen", "gioca")

              private fun maybeStartSwitch(now: Long): Boolean {
                  if (ocrFailed || now < swCooldownUntil) return false
                  val ui = getSharedPreferences("ui2", Context.MODE_PRIVATE)
                  val swOn = ui.getBoolean("switch_on", true)
                  val apOn = ui.getBoolean("auto_profile", true)
                  if (!swOn && !apOn) return false
                  if (!swOn && !swFirst) return false
                  if (!swFirst && matchesSinceCheck < 2) return false
                  swActive = true
                  swMsg = "iniciando"
                  swExec.execute { runSwitch() }
                  return true
              }

              private fun runSwitch() {
                  var res = ""
                  try {
                      res = doSwitch()
                  } catch (t: Throwable) {
                      res = "erro: " + t.javaClass.simpleName
                  }
                  swMsg = res
                  getSharedPreferences("ui2", Context.MODE_PRIVATE).edit().putString("switch_last", res).apply()
                  val now = SystemClock.elapsedRealtime()
                  swFirst = false
                  if (res.startsWith("ok")) {
                      matchesSinceCheck = 0
                      swFails = 0
                      swCooldownUntil = now + 20000L
                  } else {
                      swFails++
                      swCooldownUntil = now + (if (swFails >= 3) 600000L else 60000L)
                  }
                  swActive = false
              }

              private fun alive(): Boolean = gameFront && !userStopped && !inMatch

              private fun nap(ms: Long) {
                  try { Thread.sleep(ms) } catch (e: InterruptedException) { }
              }

              /** Print em resolucao total (para o OCR). */
              private fun shotFull(): Bitmap? {
                  for (attempt in 0 until 3) {
                      val latch = CountDownLatch(1)
                      val holder = arrayOfNulls<Bitmap>(1)
                      try {
                          takeScreenshot(Display.DEFAULT_DISPLAY, exec, object : TakeScreenshotCallback {
                              override fun onSuccess(r: ScreenshotResult) {
                                  try {
                                      val hw = Bitmap.wrapHardwareBuffer(r.hardwareBuffer, r.colorSpace)
                                      holder[0] = hw?.copy(Bitmap.Config.ARGB_8888, false)
                                  } catch (e: Throwable) { }
                                  try { r.hardwareBuffer.close() } catch (e: Throwable) { }
                                  latch.countDown()
                              }

                              override fun onFailure(errorCode: Int) { latch.countDown() }
                          })
                          latch.await(3, TimeUnit.SECONDS)
                      } catch (e: Exception) { }
                      val b = holder[0]
                      if (b != null) return b
                      nap(450)
                  }
                  return null
              }

              private fun tapAt(o: OcrItem, bmp: Bitmap) {
                  menuTap = floatArrayOf(o.cx / bmp.width, o.cy / bmp.height)
                  nap(350)
              }

              private fun pressBack() {
                  main.post { performGlobalAction(GLOBAL_ACTION_BACK) }
                  nap(1100)
              }

              private fun find(items: List<OcrItem>, labels: Array<String>): OcrItem? {
                  for (o in items) {
                      val t = o.text.lowercase()
                      for (l in labels) if (t.contains(l)) return o
                  }
                  return null
              }

              private fun isLobby(items: List<OcrItem>): Boolean = find(items, playLabels) != null && find(items, arrayOf("brawlers")) != null

              private fun keyOf(o: OcrItem): String = o.text + "@" + (o.cx / 60f).toInt() + "_" + (o.cy / 60f).toInt()

              private fun exitToLobby(eng: Ocr) {
                  for (i in 0 until 3) {
                      nap(500)
                      val b = shotFull() ?: return
                      if (isLobby(eng.read(b))) return
                      pressBack()
                  }
              }

              private fun applyProfile(idx: Int) {
                  synchronized(procLock) {
                      brain.setProfile(idx)
                      policy = null
                      params = null
                  }
              }

              /**
               * Abre a tela Brawlers, le os trofeus de cada card (OCR), escolhe o brawler com MAIS trofeus ainda abaixo de 1000
               * (quem ja chegou a 1000 fica de fora), toca em Selecionar e adota o perfil da classe dele.
               */
              private fun doSwitch(): String {
                  var engine: Ocr? = ocr
                  if (engine == null) {
                      try {
                          engine = Ocr()
                          ocr = engine
                      } catch (t: Throwable) {
                          ocrFailed = true
                          return "sem OCR: " + t.javaClass.simpleName
                      }
                  }
                  val eng = engine ?: return "sem OCR"
                  nap(400)
                  swMsg = "procurando o botao Brawlers"
                  var bmp = shotFull() ?: return "falha: sem print"
                  var items = eng.read(bmp)
                  val ui = getSharedPreferences("ui2", Context.MODE_PRIVATE)
                  if (ui.getBoolean("auto_profile", true)) {
                      val c0 = BrawlerClasses.classify(items)
                      if (c0 >= 0) applyProfile(c0)
                  }
                  if (!ui.getBoolean("switch_on", true)) return "ok: perfil automatico (troca de brawler desligada)"
                  val nav = find(items, arrayOf("brawlers")) ?: return "falha: botao Brawlers nao encontrado (nao estou no lobby?)"
                  tapAt(nav, bmp)
                  nap(1800)
                  val tried = HashSet<String>()
                  var over = 0
                  for (round in 0 until 4) {
                      if (!alive()) return "cancelado"
                      nap(400)
                      bmp = shotFull() ?: return "falha: sem print"
                      items = eng.read(bmp)
                      over = 0
                      val cands = ArrayList<OcrItem>()
                      for (o in items) {
                          val t = o.text
                          val digits = t.isNotEmpty() && t.all { ch -> ch.isDigit() }
                          if (digits && t.length <= 3) {
                              val v = t.toInt()
                              if (v in 12..999 && o.cy > 0.12f * bmp.height) cands.add(o)
                          } else if (digits && t.length == 4 && t.toInt() >= 1000) {
                              over++
                          }
                      }
                      cands.sortByDescending { o -> o.text.toInt() }
                      var pick: OcrItem? = null
                      for (o in cands) {
                          if (!tried.contains(keyOf(o))) { pick = o; break }
                      }
                      if (pick == null) {
                          exitToLobby(eng)
                          return "falha: nenhum brawler abaixo de 1000 achado (com 1000 ou mais: " + over + ")"
                      }
                      tried.add(keyOf(pick))
                      swMsg = "tentando brawler com " + pick.text + " trofeus"
                      tapAt(pick, bmp)
                      nap(1600)
                      if (!alive()) return "cancelado"
                      bmp = shotFull() ?: return "falha: sem print"
                      items = eng.read(bmp)
                      val sel = find(items, selectLabels)
                      if (sel != null) {
                          val cls = BrawlerClasses.classify(items)
                          tapAt(sel, bmp)
                          nap(1800)
                          exitToLobby(eng)
                          val idx = if (cls >= 0) cls else 0
                          applyProfile(idx)
                          return "ok: selecionado brawler com " + pick.text + " trofeus, perfil " + Profiles.NAMES[idx] + " (com 1000 ou mais: " + over + ")"
                      }
                      pressBack()   // nao era selecionavel (bloqueado?): volta para a lista e tenta o proximo
                  }
                  exitToLobby(eng)
                  return "falha: o botao Selecionar nao apareceu"
              }

              // ---------------------------------------------------------------- toques (thread principal)
              private fun tapPath(x: Float, y: Float): Path {
                  val p = Path()
                  p.moveTo(x, y)
                  return p
              }

              /** Solta o joystick (um gesto "continuado" precisa ser encerrado explicitamente). */
              private fun endMoveNow() {
                  val ms = moveStroke ?: return
                  moveStroke = null
                  try {
                      val g = GestureDescription.Builder().addStroke(ms.continueStroke(tapPath(lastX, lastY), 0, 20, false)).build()
                      dispatchGesture(g, null, null)
                  } catch (e: Exception) { }
              }

              private fun controlTick() {
                  if (!gameFront) { endMoveNow(); ctrlOn = false; return }
                  if (userStopped || sw <= sh) { endMoveNow(); main.postDelayed({ controlTick() }, 150); return }
                  val W = sw.toFloat()
                  val H = sh.toFloat()
                  val b = GestureDescription.Builder()
                  var any = false

                  val tap = menuTap
                  if (tap != null) {
                      menuTap = null
                      b.addStroke(GestureDescription.StrokeDescription(tapPath(tap[0] * W, tap[1] * H), 0, 60))
                      any = true
                  }

                  val ms = moveStroke
                  if (moving) {
                      val R = 0.15f * H
                      val tx = jx * W + moveX * R
                      val ty = jy * H + moveY * R
                      val p = Path()
                      val st: GestureDescription.StrokeDescription
                      if (ms == null) {
                          p.moveTo(jx * W, jy * H)
                          p.lineTo(tx, ty)
                          st = GestureDescription.StrokeDescription(p, 0, SEG, true)
                      } else {
                          p.moveTo(lastX, lastY)
                          p.lineTo(tx, ty)
                          st = ms.continueStroke(p, 0, SEG, true)
                      }
                      moveStroke = st
                      lastX = tx
                      lastY = ty
                      b.addStroke(st)
                      any = true
                      if (wantAim) {
                          wantAim = false
                          val ra = 0.13f * H
                          val pa = Path()
                          pa.moveTo(ax * W, ay * H)
                          pa.lineTo(ax * W + aimX * ra, ay * H + aimY * ra)
                          b.addStroke(GestureDescription.StrokeDescription(pa, 0, 70))
                      } else if (wantFire) {
                          b.addStroke(GestureDescription.StrokeDescription(tapPath(ax * W, ay * H), 0, 50))
                      }
                  } else if (ms != null) {
                      b.addStroke(ms.continueStroke(tapPath(lastX, lastY), 0, 20, false))
                      moveStroke = null
                      any = true
                  }
                  if (wantSuper) { wantSuper = false; b.addStroke(GestureDescription.StrokeDescription(tapPath(ux * W, uy * H), 0, 50)); any = true }
                  if (wantGadget) { wantGadget = false; b.addStroke(GestureDescription.StrokeDescription(tapPath(gx * W, gy * H), 0, 50)); any = true }
                  if (wantHyper) { wantHyper = false; b.addStroke(GestureDescription.StrokeDescription(tapPath(hx * W, hy * H), 0, 50)); any = true }

                  if (!any) { main.postDelayed({ controlTick() }, 30); return }
                  val ok = dispatchGesture(b.build(), object : GestureResultCallback() {
                      override fun onCompleted(g: GestureDescription?) { main.post { controlTick() } }
                      override fun onCancelled(g: GestureDescription?) { moveStroke = null; main.postDelayed({ controlTick() }, 30) }
                  }, null)
                  if (!ok) { moveStroke = null; main.postDelayed({ controlTick() }, 100) }
              }
          }
