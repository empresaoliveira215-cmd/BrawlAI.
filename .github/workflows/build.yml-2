          }

          class MatchStats {
              var durSec = 0f
              var engagedSec = 0f
              var hits = 0           // vezes que levou dano com inimigo a vista
              var gasLoss = 0f       // vida perdida sem inimigo a vista (provavel gas)
              var dmgDealt = 0f      // dano causado (barras de inimigos diminuindo)
              fun reward(): Float = durSec + 0.5f * engagedSec + 60f * dmgDealt - 3f * hits - 40f * gasLoss
          }

          /** Guarda o que a IA observa enquanto VOCE joga (botao STOP). */
          class Observer {
              private val d = FloatArray(4000)
              private val hp = FloatArray(4000)
              var n = 0
                  private set
              private var pos = 0

              fun add(dist: Float, h: Float) {
                  d[pos] = dist
                  hp[pos] = h
                  pos = (pos + 1) % 4000
                  if (n < 4000) n++
              }

              fun clear() { n = 0; pos = 0 }

              private fun median(a: FloatArray): Float {
                  if (a.isEmpty()) return 0f
                  val s = a.copyOf()
                  s.sort()
                  return s[s.size / 2]
              }

              /** [distancia preferida, banda, hp de fuga] ou null se ainda viu pouco. */
              fun result(): FloatArray? {
                  if (n < 400) return null
                  val sorted = d.copyOfRange(0, n)
                  sorted.sort()
                  val med = sorted[n / 2]
                  val band = ((sorted[(n * 3) / 4] - sorted[n / 4]) / 2f).coerceIn(0.03f, 0.15f)
                  val low = ArrayList<Float>()
                  val high = ArrayList<Float>()
                  for (i in 0 until n) {
                      if (hp[i] < 0.5f) low.add(d[i]) else if (hp[i] >= 0.7f) high.add(d[i])
                  }
                  var retreat = 0.28f
                  if (low.size >= 40 && high.size >= 40) {
                      val dl = median(low.toFloatArray())
                      val dh = median(high.toFloatArray())
                      retreat = if (dl > dh + 0.04f) 0.40f else if (dl < dh - 0.04f) 0.15f else 0.28f
                  }
                  return floatArrayOf(med.coerceIn(Params.LO[0], Params.HI[0]), band, retreat)
              }
          }

          /**
           * Memoria de SITUACOES (Q-learning). Estado = distancia x vida x inimigos perto x gas perto (72 estados).
           * Acoes taticas: 0 atacar/avancar, 1 manter distancia, 2 recuar, 3 desviar.
           * Ja nasce com conhecimento (prior) e aprende com o dano causado/recebido. Guardado por perfil.
           */
          class QBrain {
              companion object {
                  const val S = 72
                  const val A = 4
              }

              val q = FloatArray(S * A)

              init {
                  for (s in 0 until S) for (a in 0 until A) q[s * A + a] = prior(s, a)
              }

              private fun prior(s: Int, a: Int): Float {
                  val g = s % 2
                  val c = (s / 2) % 3
                  val h = (s / 6) % 3
                  val dB = s / 18
                  var v = 0f
                  if (h == 0 || (c >= 2 && h < 2)) {
                      if (a == 2) v += 0.6f
                      if (a == 3) v += 0.25f
                  } else {
                      if (dB == 3) { if (a == 0) v += 0.4f }
                      else if (dB == 2) { if (a == 1) v += 0.4f }
                      else if (dB == 1) { if (a == 1) v += 0.3f; if (a == 3) v += 0.2f }
                      else { if (a == 3) v += 0.35f; if (a == 1) v += 0.15f }
                  }
                  if (g == 1 && a == 2) v += 0.2f
                  return v
              }

              fun state(d: Float, hp: Float?, crowd: Int, gasNear: Float): Int {
                  val dB = if (d < 0.2f) 0 else if (d < 0.35f) 1 else if (d < 0.55f) 2 else 3
                  val hB = if (hp == null) 1 else if (hp < 0.35f) 0 else if (hp < 0.7f) 1 else 2
                  val cB = if (crowd <= 0) 0 else if (crowd == 1) 1 else 2
                  val gB = if (gasNear >= 0.2f) 1 else 0
                  return ((dB * 3 + hB) * 3 + cB) * 2 + gB
              }

              fun choose(s: Int, eps: Float): Int {
                  if (Random.nextFloat() < eps) return Random.nextInt(A)
                  var best = 0
                  var bv = q[s * A]
                  for (a in 1 until A) if (q[s * A + a] > bv) { bv = q[s * A + a]; best = a }
                  return best
              }

              fun update(s: Int, a: Int, r: Float, s2: Int) {
                  var mx = q[s2 * A]
                  for (k in 1 until A) if (q[s2 * A + k] > mx) mx = q[s2 * A + k]
                  val i = s * A + a
                  q[i] = (q[i] + 0.15f * (r + 0.8f * mx - q[i])).coerceIn(-3f, 3f)
              }

              fun toStr(): String = q.joinToString(",")

              fun load(sp: SharedPreferences, key: String) {
                  val a = sp.getString(key, null)?.split(",")?.mapNotNull { it.toFloatOrNull() }
                  if (a != null && a.size == S * A) for (i in 0 until S * A) q[i] = a[i]
              }
          }

          /** Memoria + evolucao: uma memoria separada por perfil (parametros + Q), hill-climbing entre partidas, regras diretas e assinatura do gas. */
          class Brain(ctx: Context) {
              private val sp = ctx.getSharedPreferences("brain3", Context.MODE_PRIVATE)
              var profile = 0
                  private set
              var matches = 0
                  private set
              var bestScore = 0f
                  private set
              private var best: FloatArray = Profiles.PRESETS[0].copyOf()
              var q = QBrain()
                  private set
              private val gasHist = loadHist("gas")
              private val baseHist = loadHist("base")

              init {
                  setProfile(sp.getInt("profile", 0))
              }

              private fun loadHist(key: String): FloatArray =
                  (sp.getString(key, null)?.split(",")?.mapNotNull { it.toFloatOrNull() }?.toFloatArray()?.takeIf { it.size == 96 }) ?: FloatArray(96)

              private fun loadParams(key: String): FloatArray? =
                  sp.getString(key, null)?.split(",")?.mapNotNull { it.toFloatOrNull() }?.toFloatArray()?.takeIf { it.size == Params.N }

              fun setProfile(idx: Int) {
                  val i = idx.coerceIn(0, Profiles.PRESETS.size - 1)
                  profile = i
                  sp.edit().putInt("profile", i).apply()
                  matches = sp.getInt("matches_" + i, 0)
                  bestScore = sp.getFloat("best_" + i, 0f)
                  best = loadParams("params_" + i) ?: Profiles.PRESETS[i].copyOf()
                  q = QBrain()
                  q.load(sp, "q_" + i)
              }

              fun sample(): Params {
                  val sigma = 0.25f / (1f + matches / 30f) + 0.04f
                  val a = FloatArray(Params.N) { i ->
                      val range = Params.HI[i] - Params.LO[i]
                      (best[i] + (Random.nextFloat() * 2f - 1f) * sigma * range).coerceIn(Params.LO[i], Params.HI[i])
                  }
                  return Params.from(a)
              }

              /** Taxa de exploracao do Q-learning: diminui conforme a IA ganha experiencia. */
              fun epsilon(): Float = maxOf(0.04f, 0.14f - 0.003f * matches)

              private fun add(i: Int, d: Float) { best[i] = (best[i] + d).coerceIn(Params.LO[i], Params.HI[i]) }
              private fun mul(i: Int, f: Float) { best[i] = (best[i] * f).coerceIn(Params.LO[i], Params.HI[i]) }

              fun report(p: Params, st: MatchStats) {
                  val reward = maxOf(1f, st.reward())
                  matches++
                  if (matches <= 3 || reward >= bestScore * 0.97f) {
                      best = p.toArray()
                      bestScore = if (matches <= 3) maxOf(bestScore, reward) else 0.7f * bestScore + 0.3f * reward
                  } else {
                      bestScore *= 0.98f
                  }
                  // aprendizado direto, a partir do que aconteceu na partida
                  if (st.gasLoss > 0.12f) mul(9, 1.25f)                                   // perdeu vida no gas: foge mais cedo
                  if (st.hits >= 4 && st.dmgDealt < 0.3f) { add(0, 0.02f); add(6, 0.05f) }  // levou muito e bateu pouco: afasta e esquiva
                  if (st.dmgDealt < 0.15f && st.engagedSec > 8f) { add(3, 0.04f); add(8, 0.04f) }  // viu inimigo e nao acertou: mais alcance/antecipacao
                  persist()
              }

              /** Mistura o que foi observado no jogo do usuario (50%) com o que a IA ja sabia. */
              fun seedFromObservation(pref: Float, band: Float, retreat: Float) {
                  best[0] = (0.5f * best[0] + 0.5f * pref).coerceIn(Params.LO[0], Params.HI[0])
                  best[1] = (0.5f * best[1] + 0.5f * band).coerceIn(Params.LO[1], Params.HI[1])
                  best[5] = (0.5f * best[5] + 0.5f * retreat).coerceIn(Params.LO[5], Params.HI[5])
                  persist()
              }

              private fun persist() {
                  sp.edit()
                      .putInt("matches_" + profile, matches)
                      .putFloat("best_" + profile, bestScore)
                      .putString("params_" + profile, best.joinToString(","))
                      .putString("q_" + profile, q.toStr())
                      .apply()
              }

              /** Grava TUDO agora (sincrono): chamado ao sair do jogo, no fim de cada partida e ao desligar o servico. */
              fun flush() {
                  sp.edit()
                      .putInt("matches_" + profile, matches)
                      .putFloat("best_" + profile, bestScore)
                      .putString("params_" + profile, best.joinToString(","))
                      .putString("q_" + profile, q.toStr())
                      .putString("gas", gasHist.joinToString(","))
                      .putString("base", baseHist.joinToString(","))
                      .commit()
              }

              private fun cap(h: FloatArray) {
                  var s = 0f
                  for (v in h) s += v
                  if (s > 200000f) for (i in h.indices) h[i] *= 0.5f
              }

              fun addGas(h: FloatArray) { for (i in 0 until 96) gasHist[i] += h[i]; cap(gasHist) }
              fun addBase(h: FloatArray) { for (i in 0 until 96) baseHist[i] += h[i]; cap(baseHist) }

              /** Quais cores aparecem muito mais quando levamos dano sem inimigo (= cor do gas). null enquanto nao aprendeu. */
              fun signature(): BooleanArray? {
                  var sg = 0f
                  var sb = 0f
                  for (i in 0 until 96) { sg += gasHist[i]; sb += baseHist[i] }
                  if (sg < 3000f || sb < 3000f) return null
                  val out = BooleanArray(96)
                  var any = false
                  for (i in 0 until 96) {
                      val g = gasHist[i] / sg
                      val b = maxOf(baseHist[i] / sb, 0.002f)
                      if (g >= 0.02f && g >= 2.5f * b) { out[i] = true; any = true }
                  }
                  return if (any) out else null
              }
          }

          /** Tudo que a IA "percebe" num quadro (preenchido pelo servico, lido pela politica). */
          class Percept {
              var now = 0.0
              var meX = 0f
              var meY = 0f
              var enemies: List<FloatArray> = emptyList()
              var allies: List<FloatArray> = emptyList()
              var hp = -1f                    // < 0 = desconhecido
              var dmg = false
              var stuck = false
              var gas: FloatArray? = null     // 8 setores + [8]; ja com previsao de para onde o gas esta indo
              var tvx = 0f                    // velocidade do alvo na tela (px/s)
              var tvy = 0f
              var turbo = false
              var erratic = 0f                // 0..1: alvo muda de direcao toda hora
              var myVx = 0f                   // velocidade propria estimada (px/s)
              var myVy = 0f
              var blocked = false             // ficamos presos nessa direcao (parede)
              var blockedX = 0f
              var blockedY = 0f
              var mode = 0                    // 0 solo, 1 dupla, 2 equipe (3v3)
          }

          class Move(
              val dx: Float, val dy: Float,
              val fire: Int,              // 0 nada, 1 toque (auto-mira), 2 mira manual
              val aimX: Float, val aimY: Float,
              val sup: Boolean, val engaged: Boolean,
              val act: Int                // 0 atacar, 1 distancia, 2 recuar, 3 desviar
          )

          class Policy(private val p: Params, private val H: Float, private val q: QBrain?, private val eps: Float) {
              private var sign = if (Random.nextBoolean()) 1 else -1
              private var flipAt = 0.0
              private var dodgeUntil = 0.0
              private var dodgeSign = 1
              private var wander = rand()
              private var wanderUntil = 0.0
              private var unstickUntil = 0.0
              private var unstick = floatArrayOf(0f, 0f)
              private var ghostX = 0f
              private var ghostY = 0f
              private var ghostUntil = 0.0
              private var nextDecide = 0.0
              private var lastS = -1
              private var lastA = 1
              private var curAct = 1
              private var accReward = 0f

              private fun rand(): FloatArray {
                  val a = Random.nextDouble(0.0, 2 * Math.PI)
                  return floatArrayOf(Math.cos(a).toFloat(), Math.sin(a).toFloat())
              }

              fun reward(r: Float) { accReward += r }

              fun decide(pc: Percept): Move {
                  val now = pc.now
                  val meX = pc.meX
                  val meY = pc.meY
                  val enemies = pc.enemies
                  val gas = pc.gas
                  val turbo = pc.turbo
                  val hp: Float? = if (pc.hp >= 0f) pc.hp else null

                  // ---- gas (ja com previsao): foge cedo e com prioridade quando esta perto/dentro
                  var gx = 0f
                  var gy = 0f
                  var escX = 0f
                  var escY = 0f
                  var gasNear = 0f
                  var inGas = false
                  if (gas != null) {
                      var minK = 0
                      var minV = Float.MAX_VALUE
                      for (k in 0 until 8) {
                          val ang = -PI.toFloat() + (k + 0.5f) * (2f * PI.toFloat() / 8f)
                          gx -= gas[k] * cos(ang)
                          gy -= gas[k] * sin(ang)
                          if (gas[k] > gasNear) gasNear = gas[k]
                          if (gas[k] < minV) { minV = gas[k]; minK = k }
                      }
                      val ea = -PI.toFloat() + (minK + 0.5f) * (2f * PI.toFloat() / 8f)
                      escX = cos(ea)
                      escY = sin(ea)
                      inGas = gas[8] > 0.35f
                      val gscale = 1f + 3f * gasNear
                      gx *= gscale
                      gy *= gscale
                  }
                  val gw = p.gasAvoid
                  val gasAlarm = inGas || gasNear >= 0.40f

                  if (pc.stuck && now > unstickUntil) { unstickUntil = now + 0.9; unstick = rand() }

                  // ---- aliado mais proximo (para ficar junto do time)
                  var allyX = 0f
                  var allyY = 0f
                  var allyDist = -1f
                  if (pc.allies.isNotEmpty()) {
                      val al = pc.allies.minByOrNull { (it[0] - meX) * (it[0] - meX) + (it[1] - meY) * (it[1] - meY) }!!
                      allyX = al[0] - meX
                      allyY = al[1] - meY
                      allyDist = hypot(allyX, allyY)
                  }

                  // ---- inimigos, com memoria curta (lembra o ultimo inimigo visto por 1,2 s)
                  var list: List<FloatArray> = enemies
                  var ghostOnly = false
                  if (enemies.isNotEmpty()) {
                      val n0 = enemies.minByOrNull { (it[0] - meX) * (it[0] - meX) + (it[1] - meY) * (it[1] - meY) }!!
                      ghostX = n0[0] - meX
                      ghostY = n0[1] - meY
                      ghostUntil = now + 1.2
                  } else if (now < ghostUntil) {
                      list = listOf(floatArrayOf(meX + ghostX, meY + ghostY, 0f))
                      ghostOnly = true
                  }

                  var mx = 0f
                  var my = 0f
                  var engaged = false
                  var fire = 0
                  var aimX = 0f
                  var aimY = 0f
                  var sup = false
                  var act = 1

                  if (list.isEmpty()) {
                      if (now >= wanderUntil) { wander = rand(); wanderUntil = now + Random.nextDouble(1.2, 3.0) }
                      mx = wander[0] + gx * 1.5f * gw
                      my = wander[1] + gy * 1.5f * gw
                  } else {
                      val t = list.minByOrNull { (it[0] - meX) * (it[0] - meX) + (it[1] - meY) * (it[1] - meY) }!!
                      val vx = t[0] - meX
                      val vy = t[1] - meY
                      val dist = hypot(vx, vy).coerceAtLeast(1f)
                      val ux = vx / dist
                      val uy = vy / dist
                      val px = -uy
                      val py = ux
                      val d = dist / H

                      // ameaca geral: direcao "para longe de todos", ponderada pela proximidade
                      var rx = 0f
                      var ry = 0f
                      var crowd = 0
                      for (e in list) {
                          val ex = meX - e[0]
                          val ey = meY - e[1]
                          val ed = hypot(ex, ey).coerceAtLeast(1f)
                          val en = ed / H
                          if (en < 0.6f) {
                              val w8 = 1f / (0.15f + en)
                              rx += ex / ed * w8
                              ry += ey / ed * w8
                          }
                          if (en < 0.45f) crowd++
                      }
                      val rn = hypot(rx, ry)
                      if (rn > 0.001f) { rx /= rn; ry /= rn }

                      engaged = !ghostOnly
                      val flip = if (turbo) p.strafe * 0.5 else p.strafe.toDouble()
                      if (now >= flipAt) { sign = -sign; flipAt = now + flip * Random.nextDouble(0.7, 1.3) }
                      if (pc.dmg && now > dodgeUntil) { dodgeUntil = now + p.dodge; dodgeSign = if (Random.nextBoolean()) 1 else -1 }

                      // ---- decisao tatica: memoria de situacoes (Q) + regra de seguranca
                      val hardRetreat = (hp != null && hp < p.retreatHp) || (crowd >= 2 && (hp == null || hp < 0.7f))
                      val qq = q
                      if (qq != null && !ghostOnly) {
                          if (now >= nextDecide) {
                              val s = qq.state(d, hp, crowd, gasNear)
                              if (lastS >= 0) qq.update(lastS, lastA, accReward, s)
                              accReward = 0f
                              val chosen = if (hardRetreat) 2 else qq.choose(s, eps)
                              lastS = s
                              lastA = chosen
                              curAct = chosen
                              nextDecide = now + 0.35
                          }
                          act = curAct
                      }
                      if (hardRetreat) act = 2

                      val dodging = now < dodgeUntil || act == 3
                      if (act == 0) {
                          if (d > p.prefDist - p.band) { mx = ux; my = uy }
                      } else if (act == 1) {
                          if (d > p.prefDist + p.band) { mx = ux; my = uy }
                          else if (d < p.prefDist - p.band) { mx = -ux; my = -uy }
                      } else if (act == 2) {
                          mx = rx; my = ry
                      } else {
                          mx = -ux * 0.3f; my = -uy * 0.3f
                      }
                      if (crowd >= 2 && act != 2) { mx += rx * 0.4f; my += ry * 0.4f }

                      val s = if (dodging) dodgeSign else sign
                      var wgt = if (dodging) (if (turbo) 1.5f else 1.2f) else (if (turbo) 1.0f else 0.7f)
                      if (act == 3) wgt = 1.4f
                      if (act == 2) wgt = 0.4f
                      mx += px * s * wgt + gx * gw
                      my += py * s * wgt + gy * gw

                      // ---- tiro
                      if (!ghostOnly) {
                          val fr = if (turbo) p.fireRange * 1.1f else p.fireRange
                          if (d <= fr) {
                              if (d <= p.aimRange) {
                                  fire = 1                       // perto: toque = auto-mira no mais proximo
                              } else {
                                  fire = 2                       // longe: mira manual, para onde o inimigo VAI estar
                                  val wvx = pc.tvx + pc.myVx     // velocidade do inimigo no "mundo" (a camera segue a gente)
                                  val wvy = pc.tvy + pc.myVy
                                  val lt = (p.lead * (0.5f + d) * (1f - 0.6f * pc.erratic)).coerceIn(0f, 0.9f)
                                  var ax = vx + wvx * lt
                                  var ay = vy + wvy * lt
                                  if (hypot(ax, ay) < 1f) { ax = vx; ay = vy }
                                  val n2 = hypot(ax, ay).coerceAtLeast(1f)
                                  aimX = ax / n2
                                  aimY = ay / n2
                              }
                          }
                          sup = d <= (if (turbo) p.superRange * 1.2f else p.superRange)
                      }
                  }

                  // ---- time: em equipe, nao se afasta demais dos aliados
                  if (pc.mode >= 1 && allyDist > 0.40f * H && act != 2) {
                      mx += allyX / allyDist * 0.5f
                      my += allyY / allyDist * 0.5f
                  }

                  // ---- parede: se ficamos presos nessa direcao, nao insiste nela
                  if (pc.blocked) {
                      val bl = hypot(pc.blockedX, pc.blockedY)
                      if (bl > 0.01f) {
                          val bx = pc.blockedX / bl
                          val by = pc.blockedY / bl
                          val dot = mx * bx + my * by
                          if (dot > 0f) {
                              mx -= bx * dot * 1.2f
                              my -= by * dot * 1.2f
                              mx += -by * 0.5f
                              my += bx * 0.5f
                          }
                      }
                  }

                  if (now < unstickUntil) { mx = unstick[0]; my = unstick[1] }
                  else if (gasAlarm) { mx = escX * 1.5f + mx * 0.3f; my = escY * 1.5f + my * 0.3f }
                  val n = hypot(mx, my).coerceAtLeast(0.001f)
                  return Move(mx / n, my / n, fire, aimX, aimY, sup, engaged, act)
              }
          }
