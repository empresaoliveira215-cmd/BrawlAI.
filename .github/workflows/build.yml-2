          BRAWLAI_EOF_7731
          cat > app/src/main/java/com/brawlai/app/Vision.kt <<'BRAWLAI_EOF_7731'
          package com.brawlai.app

          import android.graphics.Bitmap
          import android.graphics.Color
          import kotlin.math.PI
          import kotlin.math.atan2

          class Blob(val x: Int, val y: Int, val w: Int, val h: Int, val count: Int) {
              val cx get() = x + w / 2f
              val cy get() = y + h / 2f
          }

          class Analysis(
              val w: Int, val h: Int,
              val inMatch: Boolean,
              val redRatio: Float,
              val yellowRatio: Float,
              val meX: Float, val meY: Float, val myBarW: Float,   // myBarW = 0 se nao achou
              val enemies: List<FloatArray>,                       // [x, y, larguraBarra] barras VERMELHAS
              val allies: List<FloatArray>,                        // barras AZUIS (aliados)
              val button: FloatArray?,                             // [fx, fy] botao amarelo grande
              val greenButton: FloatArray?,
              val sig: IntArray,
              val gas: FloatArray?                                 // 8 setores + [8]=em cima de mim (null se ainda nao aprendeu o gas)
          )

          /** Visao por cor + "assinatura de gas" aprendida com o dano que o jogador toma. */
          class Vision {
              @Volatile var gasSig: BooleanArray? = null
              private var px = IntArray(0)
              private var bins = ByteArray(0)
              private var bw = 0
              private var bh = 0
              private val hsv = FloatArray(3)

              fun analyze(bmp: Bitmap, w: Int, h: Int): Analysis {
                  val n = w * h
                  if (px.size != n) { px = IntArray(n); bins = ByteArray(n) }
                  bw = w
                  bh = h
                  bmp.getPixels(px, 0, w, 0, 0, w, h)
                  val red = BooleanArray(n)
                  val green = BooleanArray(n)
                  val yellow = BooleanArray(n)
                  val blue = BooleanArray(n)
                  for (i in 0 until n) {
                      Color.colorToHSV(px[i], hsv)
                      val hh = hsv[0]
                      val s = hsv[1]
                      val v = hsv[2]
                      if (v >= 0.35f) {
                          var hb = (hh / 15f).toInt()
                          if (hb > 23) hb = 23
                          var sb = (s * 4f).toInt()
                          if (sb > 3) sb = 3
                          bins[i] = (hb * 4 + sb).toByte()
                      } else {
                          bins[i] = -1
                      }
                      if (s > 0.55f && v > 0.55f) {
                          if (hh < 12f || hh > 348f) red[i] = true
                          else if (hh in 80f..165f) green[i] = true
                          else if (hh in 195f..255f) blue[i] = true
                      }
                      if (s > 0.60f && v > 0.80f && hh in 36f..68f) yellow[i] = true
                  }
                  // assinatura de luminancia 16x9 (detecta tela parada = personagem preso)
                  val sig = IntArray(16 * 9)
                  for (gy in 0 until 9) for (gx in 0 until 16) {
                      val c = px[((gy * h) / 9 + h / 18) * w + (gx * w) / 16 + w / 32]
                      sig[gy * 16 + gx] = (Color.red(c) * 3 + Color.green(c) * 6 + Color.blue(c)) / 10
                  }

                  val redAtk = ratio(red, w, h, 0.74f, 0.58f, 0.99f, 0.97f)
                  val yelAtk = ratio(yellow, w, h, 0.74f, 0.58f, 0.99f, 0.97f)

                  // barras de vida (copias das mascaras, sem HUD)
                  val rb = red.copyOf()
                  val gb = green.copyOf()
                  val bb = blue.copyOf()
                  for (m in arrayOf(rb, gb, bb)) {
                      clear(m, w, h, 0f, 0f, 1f, 0.10f)      // HUD de cima
                      clear(m, w, h, 0.72f, 0.55f, 1f, 1f)   // botoes de ataque
                      clear(m, w, h, 0f, 0.60f, 0.30f, 1f)   // joystick
                      closeH(m, w, h, 3)
                  }
                  val off = 0.07f * h
                  val enemies = ArrayList<FloatArray>()
                  for (b in blobs(rb, w, h)) if (isBar(b, w, h)) enemies.add(floatArrayOf(b.cx, b.cy + off, b.w.toFloat()))
                  val allies = ArrayList<FloatArray>()
                  for (b in blobs(bb, w, h)) if (isBar(b, w, h)) allies.add(floatArrayOf(b.cx, b.cy + off, b.w.toFloat()))
                  var meX = w / 2f
                  var meY = h / 2f
                  var myW = 0f
                  var bestD = Float.MAX_VALUE
                  for (b in blobs(gb, w, h)) if (isBar(b, w, h)) {
                      val d = Math.hypot((b.cx - w / 2f).toDouble(), (b.cy - h / 2f).toDouble()).toFloat()
                      if (d < 0.35f * h && d < bestD) { bestD = d; meX = b.cx; meY = b.cy + off; myW = b.w.toFloat() }
                  }
                  val meNearCenter = myW > 0f && bestD < 0.22f * h
                  val inMatch = yelAtk < 0.10f && (redAtk > 0.045f || meNearCenter)

                  var button: FloatArray? = null
                  var gbutton: FloatArray? = null
                  var gas: FloatArray? = null
                  if (inMatch) {
                      val sg = gasSig
                      if (sg != null) gas = gasDensity(sg, meX, meY, w, h)
                  } else {
                      gbutton = bestButton(green, w, h, 0.006f)
                      button = bestButton(yellow, w, h, 0.004f)
                  }
                  return Analysis(w, h, inMatch, redAtk, yelAtk, meX, meY, myW, enemies, allies, button, gbutton, sig, gas)
              }

              /** Conta, em volta do jogador, quantos pixels tem a "cor do gas" aprendida, por setor (8) e em cima dele ([8]). */
              private fun gasDensity(sg: BooleanArray, cx: Float, cy: Float, w: Int, h: Int): FloatArray {
                  val cnt = IntArray(9)
                  val tot = IntArray(9)
                  val r = 0.45f * h
                  val r2 = r * r
                  val rin = 0.12f * h
                  val rin2 = rin * rin
                  val x0 = maxOf(0, (cx - r).toInt())
                  val x1 = minOf(w - 1, (cx + r).toInt())
                  val y0 = maxOf(0, (cy - r).toInt())
                  val y1 = minOf(h - 1, (cy + r).toInt())
                  var y = y0
                  while (y <= y1) {
                      var x = x0
                      while (x <= x1) {
                          val dx = x - cx
                          val dy = y - cy
                          val d2 = dx * dx + dy * dy
                          if (d2 <= r2) {
                              val bi = bins[y * w + x].toInt()
                              val isG = bi >= 0 && sg[bi]
                              var k = 8
                              if (d2 > rin2) {
                                  k = ((atan2(dy, dx) + PI) / (2.0 * PI) * 8.0).toInt()
                                  if (k > 7) k = 7
                                  if (k < 0) k = 0
                              }
                              tot[k]++
                              if (isG) cnt[k]++
                          }
                          x += 2
                      }
                      y += 2
                  }
                  return FloatArray(9) { i -> if (tot[i] > 0) cnt[i].toFloat() / tot[i] else 0f }
              }

              /** Histograma (96 cores) do anel em volta do jogador - usado para aprender como o gas parece. */
              fun ringHist(cx: Float, cy: Float, out: FloatArray) {
                  if (bw == 0 || bh == 0) return
                  val r0 = 0.10f * bh
                  val r1 = 0.40f * bh
                  val a2 = r0 * r0
                  val b2 = r1 * r1
                  val x0 = maxOf(0, (cx - r1).toInt())
                  val x1 = minOf(bw - 1, (cx + r1).toInt())
                  val y0 = maxOf(0, (cy - r1).toInt())
                  val y1 = minOf(bh - 1, (cy + r1).toInt())
                  var y = y0
                  while (y <= y1) {
                      var x = x0
                      while (x <= x1) {
                          val dx = x - cx
                          val dy = y - cy
                          val d2 = dx * dx + dy * dy
                          if (d2 >= a2 && d2 <= b2) {
                              val bi = bins[y * bw + x].toInt()
                              if (bi in 0..95) out[bi] += 1f
                          }
                          x += 3
                      }
                      y += 3
                  }
              }

              private fun bestButton(mask: BooleanArray, w: Int, h: Int, minFrac: Float): FloatArray? {
                  val m = mask.copyOf()
                  closeH(m, w, h, 8)
                  var best: Blob? = null
                  for (b in blobs(m, w, h)) {
                      if (b.count < minFrac * w * h) continue
                      if (b.cy < 0.40f * h) continue
                      if (best == null || b.count > best.count) best = b
                  }
                  return best?.let { floatArrayOf(it.cx / w, it.cy / h) }
              }

              private fun isBar(b: Blob, w: Int, h: Int): Boolean =
                  b.w >= 0.03f * w && b.w <= 0.16f * w && b.h >= 0.006f * h && b.h <= 0.05f * h && b.w >= 2.5f * b.h

              private fun ratio(m: BooleanArray, w: Int, h: Int, x0: Float, y0: Float, x1: Float, y1: Float): Float {
                  val ax = (x0 * w).toInt()
                  val bx = (x1 * w).toInt()
                  val ay = (y0 * h).toInt()
                  val by = (y1 * h).toInt()
                  var c = 0
                  for (y in ay until by) for (x in ax until bx) if (m[y * w + x]) c++
                  return c.toFloat() / maxOf(1, (bx - ax) * (by - ay))
              }

              private fun clear(m: BooleanArray, w: Int, h: Int, x0: Float, y0: Float, x1: Float, y1: Float) {
                  for (y in (y0 * h).toInt() until (y1 * h).toInt()) for (x in (x0 * w).toInt() until (x1 * w).toInt()) m[y * w + x] = false
              }

              private fun closeH(m: BooleanArray, w: Int, h: Int, gap: Int) {
                  for (y in 0 until h) {
                      var last = -1000
                      for (x in 0 until w) {
                          if (m[y * w + x]) {
                              val g = x - last - 1
                              if (g in 1..gap) for (k in last + 1 until x) m[y * w + k] = true
                              last = x
                          }
                      }
                  }
              }

              private fun blobs(mask: BooleanArray, w: Int, h: Int): List<Blob> {
                  val n = w * h
                  val seen = BooleanArray(n)
                  val stack = IntArray(n)
                  val out = ArrayList<Blob>()
                  for (s in 0 until n) {
                      if (!mask[s] || seen[s]) continue
                      var sp = 0
                      stack[sp++] = s
                      seen[s] = true
                      var x0 = w
                      var y0 = h
                      var x1 = 0
                      var y1 = 0
                      var cnt = 0
                      while (sp > 0) {
                          val i = stack[--sp]
                          val x = i % w
                          val y = i / w
                          cnt++
                          if (x < x0) x0 = x
                          if (x > x1) x1 = x
                          if (y < y0) y0 = y
                          if (y > y1) y1 = y
                          if (x > 0 && mask[i - 1] && !seen[i - 1]) { seen[i - 1] = true; stack[sp++] = i - 1 }
                          if (x < w - 1 && mask[i + 1] && !seen[i + 1]) { seen[i + 1] = true; stack[sp++] = i + 1 }
                          if (y > 0 && mask[i - w] && !seen[i - w]) { seen[i - w] = true; stack[sp++] = i - w }
                          if (y < h - 1 && mask[i + w] && !seen[i + w]) { seen[i + w] = true; stack[sp++] = i + w }
                      }
                      out.add(Blob(x0, y0, x1 - x0 + 1, y1 - y0 + 1, cnt))
                  }
                  return out
              }
          }
