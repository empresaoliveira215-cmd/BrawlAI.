          package com.brawlai.app

          import android.graphics.Bitmap
          import com.google.android.gms.tasks.Tasks
          import com.google.mlkit.vision.common.InputImage
          import com.google.mlkit.vision.text.TextRecognition
          import com.google.mlkit.vision.text.latin.TextRecognizerOptions
          import java.util.concurrent.TimeUnit

          class OcrItem(val text: String, val x: Float, val y: Float, val w: Float, val h: Float) {
              val cx get() = x + w / 2f
              val cy get() = y + h / 2f
          }

          /** Leitura de texto na tela, no proprio celular (modelo embutido, sem internet). */
          class Ocr {
              private val rec = TextRecognition.getClient(TextRecognizerOptions.DEFAULT_OPTIONS)

              /** Bloqueia a thread: nunca chamar na thread principal. */
              fun read(bmp: Bitmap): List<OcrItem> {
                  val t = Tasks.await(rec.process(InputImage.fromBitmap(bmp, 0)), 10, TimeUnit.SECONDS)
                  val out = ArrayList<OcrItem>()
                  for (b in t.textBlocks) {
                      for (l in b.lines) {
                          for (e in l.elements) {
                              val r = e.boundingBox
                              if (r != null) out.add(OcrItem(e.text, r.left.toFloat(), r.top.toFloat(), r.width().toFloat(), r.height().toFloat()))
                          }
                      }
                  }
                  return out
              }
          }

          /** Classe (perfil) de cada brawler conhecido. Indices de Profiles: 1 Dano, 2 Tanque, 3 Atirador, 4 Artilharia, 5 Assassino, 6 Suporte, 7 Controlador. */
          object BrawlerClasses {
              private val TABLE: Map<String, Int> = mapOf(
                  // Tanques
                  "el primo" to 2, "bull" to 2, "rosa" to 2, "frank" to 2, "darryl" to 2, "jacky" to 2,
                  "ash" to 2, "hank" to 2, "meg" to 2, "ollie" to 2, "trunk" to 2,
                  // Artilharia
                  "barley" to 4, "dynamike" to 4, "grom" to 4, "juju" to 4, "larry lawrie" to 4,
                  "penny" to 4, "sprout" to 4, "tick" to 4,
                  // Atiradores (Marksman)
                  "brock" to 3, "janet" to 3, "maisie" to 3, "mandy" to 3, "nani" to 3, "piper" to 3,
                  "bea" to 3, "belle" to 3, "angelo" to 3, "colt" to 3, "rico" to 3,
                  // Suporte
                  "gus" to 6, "kit" to 6, "max" to 6, "pam" to 6, "poco" to 6, "ruffs" to 6, "byron" to 6, "berry" to 6,
                  // Controladores
                  "meeple" to 7, "mr p" to 7, "otis" to 7, "sandy" to 7, "sirius" to 7, "squeak" to 7,
                  "willow" to 7, "ziggy" to 7, "emz" to 7, "gale" to 7, "lou" to 7, "charlie" to 7,
                  // Assassinos
                  "crow" to 5, "leon" to 5, "mortis" to 5, "edgar" to 5, "fang" to 5, "stu" to 5,
                  // Dano
                  "shelly" to 1, "colette" to 1, "surge" to 1, "carl" to 1, "bibi" to 1, "nita" to 1,
                  "bo" to 1, "amber" to 1, "lola" to 1, "chester" to 1
              )

              /** Indice do perfil do brawler lido na tela, ou -1 se nao reconheceu. */
              fun classify(items: List<OcrItem>): Int {
                  val words = HashSet<String>()
                  val sb = StringBuilder()
                  for (o in items) {
                      val w = o.text.lowercase().filter { ch -> ch.isLetter() }
                      if (w.isNotEmpty()) {
                          words.add(w)
                          sb.append(w).append(' ')
                      }
                  }
                  val joined = sb.toString()
                  for ((k, v) in TABLE) if (k.contains(' ') && joined.contains(k)) return v
                  for ((k, v) in TABLE) if (!k.contains(' ') && words.contains(k)) return v
                  return -1
              }
          }
          BRAWLAI_EOF_7731
          cat > app/src/main/java/com/brawlai/app/Backup.kt <<'BRAWLAI_EOF_7731'
          package com.brawlai.app

          import android.content.ContentValues
          import android.content.Context
          import android.net.Uri
          import android.provider.MediaStore
          import org.json.JSONArray
          import org.json.JSONObject

          /** Backup/restauracao do "cerebro" (tudo que a IA aprendeu + calibracao + opcoes). */
          object Backup {
              private val FILES = arrayOf("brain3", "cal", "ui2")

              fun toJson(ctx: Context): String {
                  val root = JSONObject()
                  for (f in FILES) {
                      val o = JSONObject()
                      val all = ctx.getSharedPreferences(f, Context.MODE_PRIVATE).all
                      for ((k, v) in all) {
                          val arr = JSONArray()
                          when (v) {
                              is Int -> { arr.put("i"); arr.put(v) }
                              is Float -> { arr.put("f"); arr.put(v.toDouble()) }
                              is Boolean -> { arr.put("b"); arr.put(v) }
                              is String -> { arr.put("s"); arr.put(v) }
                              else -> continue
                          }
                          o.put(k, arr)
                      }
                      root.put(f, o)
                  }
                  return root.toString()
              }

              fun fromJson(ctx: Context, text: String): Boolean {
                  try {
                      val root = JSONObject(text)
                      for (f in FILES) {
                          val o = root.optJSONObject(f) ?: continue
                          val ed = ctx.getSharedPreferences(f, Context.MODE_PRIVATE).edit()
                          val keys = o.keys()
                          while (keys.hasNext()) {
                              val k = keys.next()
                              val arr = o.getJSONArray(k)
                              val t = arr.getString(0)
                              if (t == "i") ed.putInt(k, arr.getInt(1))
                              else if (t == "f") ed.putFloat(k, arr.getDouble(1).toFloat())
                              else if (t == "b") ed.putBoolean(k, arr.getBoolean(1))
                              else if (t == "s") ed.putString(k, arr.getString(1))
                          }
                          ed.commit()
                      }
                      return true
                  } catch (e: Exception) {
                      return false
                  }
              }

              fun exportToDownloads(ctx: Context): String {
                  try {
                      val v = ContentValues()
                      v.put(MediaStore.Downloads.DISPLAY_NAME, "brawlai_cerebro_" + System.currentTimeMillis() + ".json")
                      v.put(MediaStore.Downloads.MIME_TYPE, "application/json")
                      v.put(MediaStore.Downloads.RELATIVE_PATH, "Download/BrawlAI")
                      val uri = ctx.contentResolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, v) ?: return "Falhou ao criar o arquivo"
                      ctx.contentResolver.openOutputStream(uri)?.use { it.write(toJson(ctx).toByteArray(Charsets.UTF_8)) }
                      return "Backup salvo em Downloads/BrawlAI"
                  } catch (e: Exception) {
                      return "Falhou: " + e.javaClass.simpleName
                  }
              }

              fun importFrom(ctx: Context, uri: Uri): Boolean {
                  try {
                      val stream = ctx.contentResolver.openInputStream(uri) ?: return false
                      val txt = stream.use { String(it.readBytes(), Charsets.UTF_8) }
                      return fromJson(ctx, txt)
                  } catch (e: Exception) {
                      return false
                  }
              }
          }
          BRAWLAI_EOF_7731

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.10.2
      - name: Compilar APK
        working-directory: BrawlAI
        run: |
          yes | sdkmanager --licenses > /dev/null || true
          gradle assembleDebug --no-daemon --stacktrace
          cp app/build/outputs/apk/debug/app-debug.apk ../BrawlAI.apk
      - name: Publicar em Releases
        uses: softprops/action-gh-release@v2
        with:
          tag_name: brawlai-${{ github.run_number }}
          name: Brawl AI (build ${{ github.run_number }})
          files: BrawlAI.apk
      - uses: actions/upload-artifact@v4
        with:
          name: BrawlAI-apk
          path: BrawlAI.apk
